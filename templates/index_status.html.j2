<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>インデックス状態 日次トラッカー | schoolwith.me</title>
<style>
:root{
  color-scheme: light;
  --plane:#f9f9f7; --surface:#fcfcfb;
  --ink:#0b0b0b; --ink2:#52514e; --muted:#898781;
  --grid:#e1e0d9; --axis:#c3c2b7; --border:rgba(11,11,11,0.10);
  --good:#0ca30c; --critical:#d03b3b; --warning:#fab219;
  --s1:#2a78d6; --s2:#eb6834; --s3:#1baf7a; --s4:#eda100; --s5:#e87ba4;
  --chip:#f0efec;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    color-scheme: dark;
    --plane:#0d0d0d; --surface:#1a1a19;
    --ink:#ffffff; --ink2:#c3c2b7; --muted:#898781;
    --grid:#2c2c2a; --axis:#383835; --border:rgba(255,255,255,0.10);
    --s1:#3987e5; --s2:#d95926; --s3:#199e70; --s4:#c98500; --s5:#d55181;
    --chip:#383835;
  }
}
:root[data-theme="dark"]{
  color-scheme: dark;
  --plane:#0d0d0d; --surface:#1a1a19;
  --ink:#ffffff; --ink2:#c3c2b7; --muted:#898781;
  --grid:#2c2c2a; --axis:#383835; --border:rgba(255,255,255,0.10);
  --s1:#3987e5; --s2:#d95926; --s3:#199e70; --s4:#c98500; --s5:#d55181;
  --chip:#383835;
}
*{box-sizing:border-box}
body{margin:0;background:var(--plane);color:var(--ink);
  font-family:system-ui,-apple-system,"Segoe UI",sans-serif;font-size:14px;line-height:1.6}
.wrap{max-width:1080px;margin:0 auto;padding:28px 16px 64px}
header{margin-bottom:22px}
h1{font-size:21px;margin:0 0 4px;letter-spacing:-0.01em}
.sub{color:var(--ink2);font-size:13px}
.card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:18px;margin-bottom:18px}
h2{font-size:15px;margin:0 0 3px;letter-spacing:-0.01em}
.note{color:var(--muted);font-size:12px;margin:0 0 14px}
.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(158px,1fr));gap:10px;margin-bottom:18px}
.tile{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:14px 16px}
.tile .k{color:var(--ink2);font-size:12px;display:flex;align-items:flex-start;gap:6px;min-height:2.6em}
.tile .k .dot{margin-top:5px}
.tile .v{font-size:26px;font-weight:650;margin-top:3px;letter-spacing:-0.02em}
.tile .d{font-size:12px;color:var(--muted);margin-top:1px}
.d.up{color:var(--critical)} .d.down{color:var(--good)}
.dot{width:9px;height:9px;border-radius:2px;flex:none}
table{border-collapse:collapse;width:100%;font-size:13px}
th,td{text-align:left;padding:7px 9px;border-bottom:1px solid var(--grid);vertical-align:top}
th{color:var(--ink2);font-weight:600;font-size:12px;white-space:nowrap;
   position:sticky;top:0;background:var(--surface);z-index:1}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}
td.nw{white-space:nowrap}
.scroll{max-height:520px;overflow:auto;border:1px solid var(--border);border-radius:8px}
a{color:var(--s1)}
.u{word-break:break-all;max-width:400px;display:inline-block}
.chip{display:inline-block;padding:1px 7px;border-radius:999px;background:var(--chip);
  color:var(--ink2);font-size:11.5px;white-space:nowrap}
.arrow{color:var(--muted);padding:0 5px}
.ctl{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:12px}
input[type=search],select{background:var(--surface);color:var(--ink);border:1px solid var(--axis);
  border-radius:7px;padding:6px 9px;font-size:13px;font-family:inherit}
input[type=search]{min-width:230px}
.btn{background:var(--surface);color:var(--ink);border:1px solid var(--axis);border-radius:7px;
  padding:6px 11px;font-size:13px;cursor:pointer;text-decoration:none;display:inline-block}
.btn:hover{border-color:var(--ink2)}
.empty{color:var(--muted);padding:26px 0;text-align:center}
.legend{display:flex;flex-wrap:wrap;gap:6px 16px;margin:12px 0 0;font-size:12px;color:var(--ink2)}
.legend span{display:flex;align-items:center;gap:6px}
.warn{background:var(--chip);border-left:3px solid var(--warning);padding:10px 13px;
  border-radius:0 7px 7px 0;font-size:12.5px;color:var(--ink2);margin-bottom:18px}
.chartbox{position:relative;overflow-x:auto}
svg text{font-family:inherit}
.tip{position:absolute;pointer-events:none;opacity:0;transition:opacity .08s;
  background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:8px 10px;
  font-size:12px;box-shadow:0 4px 14px rgba(0,0,0,.14);min-width:180px;z-index:5}
.tip .td{font-weight:600;margin-bottom:4px}
.tip .r{display:flex;align-items:center;gap:6px;justify-content:space-between}
.tip .r b{font-variant-numeric:tabular-nums;font-weight:600}
.sev{display:inline-block;min-width:22px;text-align:center;padding:1px 7px;border-radius:999px;
  font-size:11.5px;font-weight:650;white-space:nowrap}
.sev1{background:var(--critical);color:#fff} .sev2{background:var(--warning);color:#0b0b0b}
.sev3{background:var(--chip);color:var(--ink2)}
details.fix{border:1px solid var(--border);border-radius:8px;margin-bottom:8px;background:var(--plane)}
details.fix>summary{list-style:none;cursor:pointer;padding:10px 12px;display:flex;gap:10px;align-items:baseline}
details.fix>summary::-webkit-details-marker{display:none}
details.fix>summary .t{flex:1;font-weight:600}
details.fix>summary .n{font-variant-numeric:tabular-nums;white-space:nowrap;color:var(--ink2);font-size:12.5px}
details.fix[open]>summary{border-bottom:1px solid var(--grid)}
details.fix .body{padding:10px 14px 14px;font-size:13px}
details.fix h3{font-size:12px;color:var(--ink2);margin:12px 0 4px;font-weight:600}
details.fix ul,details.fix ol{margin:0;padding-left:20px}
details.fix li{margin:2px 0}
.newtag{color:var(--critical);font-weight:650;font-size:11.5px;white-space:nowrap}
.headline{font-size:13.5px;margin:0 0 12px}
.headline b{font-variant-numeric:tabular-nums}
footer{color:var(--muted);font-size:12px;margin-top:30px;line-height:1.8}
</style>
</head>
<body>
<div class="wrap">

<header>
  <h1>インデックス状態 日次トラッカー</h1>
  <div class="sub">schoolwith.me ／ {{ run_date }} 時点 ・ 生成 {{ generated_at }}</div>
</header>

{% if aborted %}
<div class="warn"><b>この日の巡回は途中で中断しました。</b>連続エラーが閾値に達しています。APIクォータ超過かサービスアカウントの権限失効が疑われます。件数は前日までの値を多く含みます。</div>
{% endif %}
{% if unknown_states %}
<div class="warn"><b>未知のステータス文言を検出：</b>{{ unknown_states|join(" / ") }}<br>
「その他・未分類」に入っています。<code>src/index_status/status_map.py</code> に追記してください。</div>
{% endif %}

<div class="tiles">
  <div class="tile">
    <div class="k">本日の遷移</div>
    <div class="v">{{ change_count|comma }}</div>
    <div class="d">{% if first_seen_today %}初回観測 {{ first_seen_today|comma }}件は含まず{% else %}ステータスが変わったURL{% endif %}</div>
  </div>
  <div class="tile">
    <div class="k">問題あり 合計</div>
    <div class="v">{{ problem_total|comma }}</div>
    {% if problem_delta is not none %}
    <div class="d {{ 'up' if problem_delta > 0 else ('down' if problem_delta < 0 else '') }}">
      前日比 {{ '+' if problem_delta > 0 else '' }}{{ problem_delta|comma }}</div>
    {% else %}<div class="d">前日データなし</div>{% endif %}
  </div>
  <div class="tile">
    <div class="k">インデックス登録済み</div>
    <div class="v">{{ indexed|comma }}</div>
    {% if indexed_delta is not none %}
    <div class="d {{ 'down' if indexed_delta > 0 else ('up' if indexed_delta < 0 else '') }}">
      前日比 {{ '+' if indexed_delta > 0 else '' }}{{ indexed_delta|comma }}</div>
    {% else %}<div class="d">前日データなし</div>{% endif %}
  </div>
  <div class="tile">
    <div class="k">追跡URL総数</div>
    <div class="v">{{ total_urls|comma }}</div>
    <div class="d">sitemap ＋ GSC指摘</div>
  </div>
  <div class="tile">
    <div class="k">本日の照会</div>
    <div class="v">{{ checked_today|comma }}</div>
    <div class="d">失敗 {{ errors_today|comma }} ／ 未照会 {{ unchecked|comma }}</div>
  </div>
</div>


{% if not fixes.empty %}
<div class="card">
  <h2>改修案（{{ fixes.actionable|length }}件）</h2>
  <p class="note">エラーを型（ページのテンプレート）ごとにまとめ、URL検査の結果と実ページの取得結果（canonical・robots・本文量・サイトマップ・robots.txt）から原因を判定したもの。根拠はすべて実測値です。{{ fixes.date }} 時点。
  <a href="fixes.md">チケット用テキスト（Markdown）</a> ／ <a href="issues.csv">対象URL一覧（CSV）</a></p>
  <p class="headline">問題URL <b>{{ fixes.problem_urls|comma }}</b> 件{% if fixes.status_from_export %}（上の「問題あり 合計」に、まだ照会していないGSC指摘URL {{ fixes.status_from_export|comma }} 件をエクスポート時点のステータスで加えた数）{% endif %}のうち、改修案で原因を説明できたもの <b>{{ fixes.explained|comma }}</b> 件・原因未特定 <b>{{ fixes.unexplained|comma }}</b> 件。
  {% if fixes.diff_prev.base_date %}前回（{{ fixes.diff_prev.base_date }}）から 新規 <b>{{ fixes.diff_prev.new|length }}</b> 件・解消 <b>{{ fixes.diff_prev.resolved|length }}</b> 件。{% endif %}</p>
  {% for i in fixes.actionable %}
  <details class="fix">
    <summary>
      <span class="sev sev{{ i.severity }}">{{ i.severity_label }}</span>
      <span class="t">{% if i.is_new %}<span class="newtag">新規 </span>{% endif %}{{ i.title }}</span>
      <span class="n">{{ i.count|comma }}{% if i.rule == 'sitemap_no_lastmod' %} 本{% else %} 件{% endif %}{% if i.delta_prev %}（前回比 {{ '%+d'|format(i.delta_prev) }}）{% endif %}</span>
    </summary>
    <div class="body">
      <div><span class="chip">担当: {{ i.owner }}</span>{% for t in i.templates[:6] %} <span class="chip">{{ t }}</span>{% endfor %}</div>
      <h3>根拠</h3><ul>{% for e in i.evidence %}<li>{{ e }}</li>{% endfor %}</ul>
      <h3>対処</h3><ol>{% for f in i.fix %}<li>{{ f }}</li>{% endfor %}</ol>
      <h3>完了の確認</h3><div>{{ i.verify }}</div>
      <h3>例</h3><ul>{% for u in i.examples %}<li><a class="u" style="max-width:100%" href="{{ u }}" target="_blank" rel="noopener">{{ u }}</a></li>{% endfor %}</ul>
    </div>
  </details>
  {% endfor %}
  {% if fixes.watch %}
  <h2 style="margin-top:18px">監視のみ（{{ fixes.watch|length }}件）</h2>
  <p class="note">ページ側の対処は済んでいる、または意図どおりのもの。Google が再クロールすれば件数が減っていく。増え続けたら要確認。</p>
  {% for i in fixes.watch %}
  <details class="fix">
    <summary>
      <span class="sev sev3">監視</span>
      <span class="t">{{ i.title }}</span>
      <span class="n">{{ i.count|comma }} 件{% if i.delta_prev %}（前回比 {{ '%+d'|format(i.delta_prev) }}）{% endif %}</span>
    </summary>
    <div class="body">
      <h3>根拠</h3><ul>{% for e in i.evidence %}<li>{{ e }}</li>{% endfor %}</ul>
      <h3>対処</h3><ol>{% for f in i.fix %}<li>{{ f }}</li>{% endfor %}</ol>
      <h3>例</h3><ul>{% for u in i.examples %}<li><a class="u" style="max-width:100%" href="{{ u }}" target="_blank" rel="noopener">{{ u }}</a></li>{% endfor %}</ul>
    </div>
  </details>
  {% endfor %}
  {% endif %}
  {% if fixes.unexplained_top %}
  <p class="note" style="margin-top:12px">原因未特定（どの改修案にも当てはまらなかった型）：{% for t, n in fixes.unexplained_top %}<span class="chip">{{ t }} {{ n }}</span> {% endfor %}</p>
  {% endif %}
</div>

<div class="card">
  <h2>直近7日の差分（型別）</h2>
  <p class="note">{{ fixes.transitions.start }}〜{{ fixes.transitions.end }} に照会したURLのうち、登録済み等から問題ステータスへ移った（悪化）・問題ステータスから登録済み／除外等へ移った（改善）件数を型ごとに集計。「Google未認識→検出・未登録」は Google がページを見つけた前進なので「発見」として別に数えます。初回観測（未照会→判明）は含みません。巡回は約9日で一巡するので、1週間でサイト全体のおよそ8割を見た結果です。</p>
  <p class="headline">悪化 <b>{{ fixes.transitions.worse_total|comma }}</b> 件 ／ 改善 <b>{{ fixes.transitions.better_total|comma }}</b> 件 ／ 発見 <b>{{ fixes.transitions.found_total|comma }}</b> 件
  {% if fixes.diff_week.base_date %}　・改修案（{{ fixes.diff_week.base_date }} 比）新規 <b>{{ fixes.diff_week.new|length }}</b> 件・解消 <b>{{ fixes.diff_week.resolved|length }}</b> 件{% endif %}</p>
  {% if fixes.diff_week.resolved %}
  <p class="note">解消した改修案：{% for r in fixes.diff_week.resolved %}<span class="chip">{{ r.title }}（{{ r.count|comma }}件）</span> {% endfor %}</p>
  {% endif %}
  {% if fixes.transitions.rows %}
  <div class="scroll" style="max-height:420px">
  <table>
    <thead><tr><th>型</th><th class="num">悪化</th><th class="num">改善</th><th class="num">差し引き</th><th class="num">発見</th><th>悪化の例</th></tr></thead>
    <tbody>
    {% for r in fixes.transitions.rows[:40] %}
      <tr>
        <td><span class="u">{{ r.template }}</span></td>
        <td class="num">{{ r.worse|comma }}</td>
        <td class="num">{{ r.better|comma }}</td>
        <td class="num"><b style="color:{{ 'var(--critical)' if r.net > 0 else ('var(--good)' if r.net < 0 else 'inherit') }}">{{ '%+d'|format(r.net) }}</b></td>
        <td class="num">{{ r.found|comma }}</td>
        <td>{% for e in r.examples[:2] %}<div><a class="u" href="{{ e.url }}" target="_blank" rel="noopener">{{ e.url.replace('https://schoolwith.me','') }}</a> <span style="color:var(--muted)">{{ e['from'] }}→{{ e.to }}（{{ e.date[5:] }}）</span></div>{% endfor %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <div class="empty">この7日間に問題ステータスへ出入りしたURLはありません。</div>
  {% endif %}
  {% if fixes.template_diff_week %}
  <h3 style="font-size:13px;margin:16px 0 6px">問題URL数の増減（{{ fixes.diff_week.base_date }} 比・型別）</h3>
  <div class="scroll" style="max-height:320px"><table>
    <thead><tr><th>型</th><th class="num">前</th><th class="num">今</th><th class="num">増減</th></tr></thead>
    <tbody>{% for r in fixes.template_diff_week %}<tr><td><span class="u">{{ r.template }}</span></td><td class="num">{{ r.before|comma }}</td><td class="num">{{ r.after|comma }}</td><td class="num"><b>{{ '%+d'|format(r.delta) }}</b></td></tr>{% endfor %}</tbody>
  </table></div>
  {% endif %}
</div>
{% endif %}

<div class="card">
  <h2>ステータス別の件数</h2>
  <p class="note">全URLの最新既知値の合算。巡回は約8日で一巡するため、最大8日前の値を含みます{% if oldest_checked_at %}（最も古い照会日 {{ oldest_checked_at }}）{% endif %}。</p>
  <div class="tiles" style="margin-bottom:0">
  {% for c in status_cards %}
    <div class="tile">
      <div class="k" title="{{ c.label }}"><span class="dot" style="background:{{ c.light }}"></span>{{ c.short }}</div>
      <div class="v">{{ c.count|comma }}</div>
      {% if c.delta is not none %}
      <div class="d {{ 'up' if c.delta > 0 else ('down' if c.delta < 0 else '') }}">
        前日比 {{ '+' if c.delta > 0 else '' }}{{ c.delta|comma }}</div>
      {% else %}<div class="d">—</div>{% endif %}
    </div>
  {% endfor %}
  </div>
</div>

<div class="card">
  <h2>Search Console の公式値との突き合わせ</h2>
  <p class="note">GSCの「ページ」レポートにAPIは無いため、公式値は画面からエクスポートしたCSVの取り込み{% if recon.official_date %}（データ日 {{ recon.official_date }}）{% endif %}です。本ツールの実測は URL Inspection API で1URLずつ照会した結果で、<b>母集団も鮮度も違うため一致しません</b>。<br>
  ・<b>URL上限</b>＝GSCのエクスポートは1ステータスあたり1,000件で頭打ち。それ以上のURLは取得できず、追跡対象にも入りません。<br>
  ・<b>巡回途中</b>＝未照会が{{ recon.unchecked|comma }}件残っており、一巡するまで実測は過少に出ます。</p>
  <div class="scroll" style="max-height:none">
  <table>
    <thead><tr>
      <th>ステータス</th>
      <th class="num">GSC公式</th>
      <th class="num">URL取得数</th>
      <th class="num">本ツール実測</th>
      <th>注記</th>
    </tr></thead>
    <tbody>
    {% for r in recon.rows %}
      <tr>
        <td class="nw" title="{{ r.label }}"><span class="dot" style="display:inline-block;background:var(--s{{ loop.index }});margin-right:6px"></span>{{ r.short }}</td>
        <td class="num">{% if r.gsc is not none %}{{ r.gsc|comma }}{% else %}—{% endif %}</td>
        <td class="num">{{ r.exported|comma }}</td>
        <td class="num"><b>{{ r.ours|comma }}</b></td>
        <td class="nw">
          {% if r.capped %}<span class="chip">URL上限 −{{ (r.gsc - r.exported)|comma }}</span> {% endif %}
          {% if recon.unchecked %}<span class="chip">巡回途中</span>{% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</div>

<div class="card">
  <h2>GSC公式値の推移</h2>
  <p class="note">エクスポートに含まれる日次件数。取り込んだ時点までの推移で、こちらは自動更新されません（再エクスポートが必要）。<br>
  縦軸は最大値の「クロール済み・未登録」に支配されるため、桁の小さい系列の増減はグラフでは読み取れません。実数はグラフ上にカーソルを合わせるか、下の表で確認してください。</p>
  {% if official_chart.empty %}
    <div class="empty">GSCエクスポートが未取り込みです。<code>python -m src.index_status.gsc_export &lt;ZIP&gt;</code> で取り込んでください。</div>
  {% else %}
  {% with chart = official_chart, chart_id = "ochart" %}{% include "_chart.html.j2" %}{% endwith %}
  {% endif %}
</div>

<div class="card">
  <h2>問題ステータスの推移</h2>
  <p class="note">直近90日。インデックス登録済み（{{ indexed|comma }}件）は桁が違うため同じ軸には載せていません。</p>
  {% if chart.empty %}
    <div class="empty">データが2日分たまるとグラフが出ます。</div>
  {% else %}
  {% with chart_id = "chart" %}{% include "_chart.html.j2" %}{% endwith %}
  {% endif %}
</div>

<div class="card">
  <h2>本日ステータスが変わったURL（{{ change_count|comma }}件）</h2>
  <p class="note">前回このURLを照会したときと比べて変化したものだけ。<a href="changes.csv">CSVで取得</a></p>
  {% if changes %}
  <div class="scroll">
  <table>
    <thead><tr><th>URL</th><th>グループ</th><th>変化</th><th>Googleが選んだ正規URL</th><th>最終クロール</th></tr></thead>
    <tbody>
    {% for c in changes %}
      <tr>
        <td><a class="u" href="{{ c.url }}" target="_blank" rel="noopener">{{ c.url.replace('https://schoolwith.me','') or '/' }}</a></td>
        <td><span class="chip">{{ c.group }}</span></td>
        <td>{{ status_labels.get(c['from'], c['from']) }}<span class="arrow">→</span><b>{{ status_labels.get(c['to'], c['to']) }}</b></td>
        <td>{% if c.google_canonical and c.google_canonical != c.url %}
            <span class="u">{{ c.google_canonical.replace('https://schoolwith.me','') }}</span>
            {% else %}<span style="color:var(--muted)">—</span>{% endif %}</td>
        <td>{{ (c.last_crawl_time or '')[:10] }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <div class="empty">この日に変化したURLはありません。</div>
  {% endif %}
</div>

<div class="card">
  <h2>グループ × ステータス</h2>
  <p class="note">どの種類のページに問題が集中しているか。</p>
  <div class="scroll">
  <table>
    <thead><tr><th>グループ</th><th class="num">合計</th><th class="num">問題あり</th>
      {% for s in matrix.statuses %}<th class="num" title="{{ s.label }}">{{ s.short }}</th>{% endfor %}</tr></thead>
    <tbody>
    {% for r in matrix.rows %}
      <tr><td class="nw"><b>{{ r.group }}</b></td><td class="num">{{ r.total|comma }}</td>
        <td class="num"><b>{{ r.problems|comma }}</b></td>
        {% for v in r.cells %}<td class="num">{{ v|comma if v else '' }}</td>{% endfor %}</tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</div>

<div class="card">
  <h2>問題URL一覧（{{ problems_total|comma }}件）</h2>
  <p class="note">直近の照会で問題ステータスだったURL。{% if problems_truncated %}表には先頭{{ problems_shown|length|comma }}件のみ表示しています。{% endif %}<a href="problems.csv">全件CSV</a></p>
  <div class="ctl">
    <input type="search" id="q" placeholder="URLで絞り込み…">
    <select id="fs"><option value="">すべてのステータス</option>
      {% for c in status_cards %}<option value="{{ c.short }}">{{ c.short }}</option>{% endfor %}
    </select>
    <select id="fg"><option value="">すべてのグループ</option>
      {% for r in matrix.rows %}{% if r.problems %}<option value="{{ r.group }}">{{ r.group }}</option>{% endif %}{% endfor %}
    </select>
    <select id="fsrc"><option value="">すべての取得元</option>
      {% for s in sources %}<option value="{{ s }}">{{ {"sitemap":"サイトマップのみ","gsc":"GSC指摘のみ","both":"両方"}.get(s, s) }}</option>{% endfor %}
    </select>
    <span id="cnt" style="color:var(--muted);font-size:12px"></span>
  </div>
  <div class="scroll">
  <table>
    <thead><tr><th>URL</th><th>グループ</th><th>取得元</th><th>ステータス</th><th>Googleが選んだ正規URL</th><th>最終クロール</th></tr></thead>
    <tbody id="pb"></tbody>
  </table>
  </div>
</div>

<div class="card">
  <h2>用語</h2>
  <p class="note">表では短縮名を使っています。Search Console 画面の文言との対応は次のとおりです。</p>
  <table>
    <thead><tr><th>本ページの表記</th><th>Search Console の文言</th></tr></thead>
    <tbody>
    {% for g in glossary %}<tr><td><b>{{ g.short }}</b></td><td>{{ g.full }}</td></tr>{% endfor %}
    </tbody>
  </table>
</div>

<footer>
  <b>読むときの注意</b><br>
  ・数字の出どころは Search Console の <b>URL Inspection API</b> です。GSCの「ページ」レポートそのものにAPIは無いため、レポート画面の件数とは一致しません。公式値は画面からのエクスポートCSVを取り込んで併記しています。<br>
  ・<b>追跡対象はサイトマップのURLとGSCが問題視したURLの和集合</b>です。GSCが挙げるURLの多く（実測73.8%）は <code>?a8=</code> / <code>?utm_</code> / <code>/sort:</code> などパラメータ付きで、サイトマップには載っていません。<br>
  ・<b>初回観測（未照会→初めて状態が分かった）は「遷移」に数えません。</b>一巡し終わるまでの約8日間、これを混ぜると本来見たい変化がノイズに埋もれるためです。<br>
  ・APIのクォータが1日2,000URLなので、全{{ total_urls|comma }}URLを毎日は照会できません。最終照会が古い順に1日1,800件ずつ回し、<b>約8日で一巡</b>します。「本日の遷移」は、その日に照会した約1,800件の中で変化したものです。<br>
  ・照会に失敗したURLは前回の値を保持します（上書きして値を失わないため）。<br>
  ・元データ：<code>index_status/state.csv</code>（最新状態）／<code>index_status/changes/</code>（日次の遷移）／<code>index_status/daily.csv</code>（日次件数）
</footer>

</div>
<script>
(function(){
  var rows = {{ problems_shown|tojson }};
  var tb = document.getElementById('pb'), q = document.getElementById('q'),
      fs = document.getElementById('fs'), fg = document.getElementById('fg'),
      fsrc = document.getElementById('fsrc'), cnt = document.getElementById('cnt');
  var SRC = {sitemap: 'サイトマップ', gsc: 'GSC指摘', both: '両方'};
  var PAGE = 300, shown = PAGE, filtered = rows;
  function esc(s){ var d = document.createElement('div'); d.textContent = s == null ? '' : s; return d.innerHTML; }
  function shortUrl(u){ return u.replace('https://schoolwith.me','') || '/'; }
  function draw(){
    var slice = filtered.slice(0, shown);
    tb.innerHTML = slice.map(function(r){
      var gc = (r.gc && r.gc !== r.url)
        ? '<span class="u">' + esc(shortUrl(r.gc)) + '</span>'
        : '<span style="color:var(--muted)">—</span>';
      return '<tr><td><a class="u" target="_blank" rel="noopener" href="' + esc(r.url) + '">'
        + esc(shortUrl(r.url)) + '</a></td>'
        + '<td><span class="chip">' + esc(r.group) + '</span></td>'
        + '<td><span class="chip">' + esc(SRC[r.src] || r.src) + '</span></td>'
        + '<td>' + esc(r.status) + '</td><td>' + gc + '</td><td>' + esc(r.crawl) + '</td></tr>';
    }).join('');
    if (filtered.length > shown) {
      tb.innerHTML += '<tr><td colspan="6" style="text-align:center;padding:12px">'
        + '<button class="btn" id="more">さらに ' + PAGE + ' 件表示（残り '
        + (filtered.length - shown).toLocaleString() + '）</button></td></tr>';
      document.getElementById('more').onclick = function(){ shown += PAGE; draw(); };
    }
    cnt.textContent = filtered.length.toLocaleString() + ' 件該当';
  }
  function apply(){
    var t = q.value.trim().toLowerCase(), s = fs.value, g = fg.value, sc = fsrc.value;
    filtered = rows.filter(function(r){
      return (!t || r.url.toLowerCase().indexOf(t) >= 0)
        && (!s || r.status === s) && (!g || r.group === g) && (!sc || r.src === sc);
    });
    shown = PAGE; draw();
  }
  [q, fs, fg, fsrc].forEach(function(el){ el.addEventListener('input', apply); });
  apply();

  function initChart(id){
    var svg = document.getElementById(id);
    if (!svg) return;
    var payload = document.getElementById(id + '-data');
    if (!payload) return;
    var d = JSON.parse(payload.textContent),
        series = d.series, xs = d.xs, ds = d.ds,
        colors = ['var(--s1)','var(--s2)','var(--s3)','var(--s4)','var(--s5)'];
    var hit = document.getElementById(id + '-hit'),
        cross = document.getElementById(id + '-cross'),
        hdots = document.getElementById(id + '-hdots'),
        tip = document.getElementById(id + '-tip');
    function nearest(px){
      var bi = 0, bd = Infinity;
      for (var i = 0; i < xs.length; i++){ var v = Math.abs(xs[i] - px); if (v < bd){ bd = v; bi = i; } }
      return bi;
    }
    hit.addEventListener('mousemove', function(ev){
      var r = svg.getBoundingClientRect(), vb = svg.viewBox.baseVal;
      var i = nearest((ev.clientX - r.left) / r.width * vb.width);
      cross.setAttribute('x1', xs[i]); cross.setAttribute('x2', xs[i]);
      cross.setAttribute('opacity', '1');
      hdots.innerHTML = series.map(function(s, k){
        var p = s.points[i];
        return '<circle cx="' + p.x + '" cy="' + p.y + '" r="4.5" fill="' + colors[k]
          + '" stroke="var(--surface)" stroke-width="2"/>';
      }).join('');
      tip.innerHTML = '<div class="td">' + ds[i] + '</div>' + series.map(function(s, k){
        return '<div class="r"><span><span class="dot" style="display:inline-block;background:'
          + colors[k] + '"></span> ' + s.label + '</span><b>'
          + s.points[i].v.toLocaleString() + '</b></div>';
      }).join('');
      tip.style.opacity = '1';
      var left = xs[i] / vb.width * r.width + 16;
      if (left + 230 > r.width) left = xs[i] / vb.width * r.width - 246;
      tip.style.left = Math.max(0, left) + 'px';
      tip.style.top = '14px';
    });
    hit.addEventListener('mouseleave', function(){
      cross.setAttribute('opacity', '0'); hdots.innerHTML = ''; tip.style.opacity = '0';
    });
  }
  initChart('chart');
  initChart('ochart');
})();
</script>
</body>
</html>
